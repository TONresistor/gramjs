{
  "name": "telegram",
  "version": "2.32.0",
  "description": "Node.js and browser MTProto API Telegram client library",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "CryptoFile-BROWSER.d.ts",
    "CryptoFile-BROWSER.js",
    "CryptoFile.d.ts",
    "CryptoFile.js",
    "Helpers.d.ts",
    "Helpers.js",
    "Password.d.ts",
    "Password.js",
    "Utils.d.ts",
    "Utils.js",
    "Version.d.ts",
    "Version.js",
    "define.d.ts",
    "entityCache.d.ts",
    "entityCache.js",
    "index.d.ts",
    "index.js",
    "inspect-BROWSER.d.ts",
    "inspect-BROWSER.js",
    "inspect.d.ts",
    "inspect.js",
    "platform.d.ts",
    "platform.js",
    "requestIter.d.ts",
    "requestIter.js",
    "client/",
    "crypto/",
    "errors/",
    "events/",
    "extensions/",
    "network/",
    "sessions/",
    "tl/",
    "CHANGELOG.md",
    "FORK.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.10.1",
  "scripts": {
    "verify:schema": "node scripts/verify-schema.js",
    "update:schema-diff": "node scripts/update-schema-diff.js",
    "generate:tl": "npm run verify:schema && node -r ts-node/register gramjs/tl/generateModule.js",
    "build:git": "node scripts/build-git-package.js",
    "build:browser": "node generate_webpack.js",
    "typecheck": "tsc --noEmit",
    "check:generated": "node scripts/check-generated.js",
    "check:package": "node scripts/check-package.js",
    "check:git-package": "node scripts/check-git-package.js",
    "check:latest-layer": "node scripts/check-latest-layer.js",
    "check:release-tag": "node scripts/check-release-tag.js",
    "audit:exceptions": "node scripts/check-audit-exceptions.js",
    "smoke:package": "node scripts/smoke-package.js",
    "test": "jest",
    "test:ci": "npm run verify:schema && npm run typecheck && npm test -- --runInBand && npm run smoke:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TONresistor/gramjs.git"
  },
  "browser": {
    "fs": false
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TONresistor/gramjs/issues"
  },
  "keywords": [
    "telegram",
    "mtproto",
    "userbot",
    "api"
  ],
  "homepage": "https://github.com/TONresistor/gramjs#readme",
  "optionalDependencies": {
    "bufferutil": "^4.0.3",
    "utf-8-validate": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.13",
    "@babel/plugin-proposal-class-properties": "^7.12.13",
    "@babel/preset-env": "^7.12.16",
    "@types/jest": "29.5.14",
    "@types/mime": "^2.0.3",
    "@types/node": "20.19.43",
    "@types/node-localstorage": "^1.3.0",
    "@types/pako": "^1.0.1",
    "@types/websocket": "^1.0.4",
    "babel-loader": "^8.2.2",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "os-browserify": "^0.3.0",
    "prettier": "2.3.1",
    "process": "^0.11.10",
    "ts-jest": "29.4.12",
    "ts-loader": "^8.0.16",
    "ts-node": "^9.1.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "^5.9.3",
    "util": "^0.12.4",
    "webpack": "^5.69.0",
    "webpack-cli": "^4.9.2"
  },
  "dependencies": {
    "@cryptography/aes": "^0.1.1",
    "async-mutex": "^0.3.0",
    "big-integer": "^1.6.48",
    "buffer": "^6.0.3",
    "htmlparser2": "^6.1.0",
    "mime": "^3.0.0",
    "node-localstorage": "^2.2.1",
    "pako": "^2.0.3",
    "path-browserify": "^1.0.1",
    "real-cancellable-promise": "^1.1.1",
    "socks": "2.8.9",
    "store2": "2.14.4",
    "ts-custom-error": "^3.2.0",
    "websocket": "^1.0.34"
  },
  "type": "commonjs"
}
